PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/clinic_os?replicaSet=rs0
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@your-company.example
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
NODE_ENV=development
UPLOAD_DIR=uploads
LOG_REQUESTS=true
BACKUP_DIR=backups
# Backups require MongoDB Database Tools (mongodump) on PATH.

# Use a distinct Mongo backup-role account; omit the database in the URI path.
BACKUP_MONGODB_URI=mongodb://clinic_backup:replace_password@127.0.0.1:27017/?authSource=admin&replicaSet=rs0
